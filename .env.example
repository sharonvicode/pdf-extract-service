APP_NAME=extractor-service
APP_VERSION=0.1.0

# Host ports where Docker Compose publishes the reverse proxy: HTTP and HTTPS (self-signed certificate).
# Each replica always listens on 8000 inside the Docker network.
PORT=8080
HTTPS_PORT=443

# Number of extractor replicas behind the reverse proxy (the TP allows up to 5).
EXTRACTOR_REPLICAS=5

MAX_FILE_SIZE_MB=10

# Backpressure (per process): extractions running at once, extra requests that may wait
# for their turn, and the Retry-After seconds sent with the 503 when both are full.
EXTRACTION_CONCURRENCY=1
EXTRACTION_QUEUE_SIZE=20
RETRY_AFTER_SECONDS=1

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
