APP_NAME=extractor-service
APP_VERSION=0.1.0

# Host port where Docker Compose publishes the reverse proxy (each replica always listens on 8000 inside).
PORT=8000

# Number of extractor replicas behind the reverse proxy (the TP allows up to 5).
EXTRACTOR_REPLICAS=5

MAX_FILE_SIZE_MB=10

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
